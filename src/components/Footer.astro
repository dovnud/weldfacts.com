---
import { SITE } from '../lib/site';
import { brands } from '../data/models';
import { AMAZON_TAG } from '../config/affiliate';
const brandList = brands();
---
<footer class="site">
  <div class="foot-in wrap">
    <div>
      <p class="foot-brand">Weld<span>Facts</span></p>
      <p>Manufacturer pages and manuals only. If a welder spec is not printed by the maker, the cell says so. The outlet check uses those published amps and states every comparison.</p>
      <p>Corrections: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <div class="lane-mark" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>
    <div>
      <p class="foot-h">Brands</p>
      <ul>
        {brandList.map((b) => <li><a href={`/brands/${b.slug}/`}>{b.name}</a></li>)}
        <li><a href="/compare/best-for-120v/">120 V outlets</a></li>
        <li><a href="/compare/best-for-240v/">240 V outlets</a></li>
        <li><a href="/compare/best-multiprocess/">Multi-process</a></li>
        <li><a href="/models/">All models</a></li>
        <li><a href="/which-welder/">Which welder</a></li>
        <li><a href="/compare/">Compare two models</a></li>
      </ul>
    </div>
    <div>
      <p class="foot-h">This site</p>
      <ul>
        <li><a href="/how-we-verify/">How we verify</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </div>
  </div>
  <div class="disclaimer wrap">
    <p>WeldFacts.com is independent. It is not affiliated with Lincoln Electric, Miller, Hobart, ESAB, Everlast, YesWelder, Forney, Eastwood, Harbor Freight, PrimeWeld, or Amazon. Product names are trademarks of their owners and are used here to identify the machines.</p>
    <p>As an Amazon Associate, WeldFacts earns from qualifying purchases. Amazon links use tag {AMAZON_TAG}. Links are searches until a live Amazon title is checked for that one model. No prices are shown. Specs were read from manufacturer pages on 2 November 2026.</p>
  </div>
</footer>

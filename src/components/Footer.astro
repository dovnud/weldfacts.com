---
import { SITE } from '../lib/site';
import { brands } from '../data/models';
import { AMAZON_TAG } from '../config/affiliate';
const brandList = brands();
---
<footer class="site">
  <div class="foot-in wrap">
    <div>
      <p class="foot-brand">Weld<span>Facts</span></p>
      <p>Specifications are copied from manufacturer pages and manuals. Corrections: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    <div>
      <p class="foot-h">Brands</p>
      <ul>
        {brandList.map((b) => <li><a href={`/brands/${b.slug}/`}>{b.name}</a></li>)}
        <li><a href="/compare/best-for-120v/">120 V list</a></li>
        <li><a href="/compare/best-for-240v/">240 V list</a></li>
        <li><a href="/compare/best-multiprocess/">Multi-process</a></li>
        <li><a href="/models/">All models</a></li>
        <li><a href="/compare/">Two models</a></li>
      </ul>
    </div>
    <div>
      <p class="foot-h">Site</p>
      <ul>
        <li><a href="/how-we-verify/">Source rules</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
      </ul>
    </div>
  </div>
  <div class="disclaimer wrap">
    <p>WeldFacts is independent. Not Lincoln Electric, Miller, Hobart, ESAB, Everlast, YesWelder, Forney, Eastwood, Harbor Freight, PrimeWeld, or Amazon. Names identify machines.</p>
    <p>As an Amazon Associate, WeldFacts earns from qualifying purchases. Tag {AMAZON_TAG}. Links are searches until a live Amazon title is checked. No prices are shown. Manufacturer pages were read 2 November 2026. The reading rules are on <a href="/how-we-verify/">one page</a>.</p>
  </div>
</footer>

---
import type { Model } from '../data/models';
import { dutyMark, fitTokens, plugLine } from '../lib/plate';
import DutyBar from './DutyBar.astro';
interface Props { model: Model }
const { model: m } = Astro.props;
const fit = fitTokens(m);
const d120 = dutyMark(m.duty.text, 120, m.voltages);
const d240 = dutyMark(m.duty.text, 240, m.voltages);
const plug = plugLine(m.input.text);
---
<section class="nameplate" aria-label={`${m.name} rating plate`}>
  <div class="np-top">
    <p class="np-brand">{m.brand}</p>
    {m.sku && <p class="np-sku">SKU {m.sku}</p>}
  </div>
  <p class="np-name">{m.name}</p>
  <div class="np-grid">
    {m.output.published && <div class="np-cell"><span>Output</span><b>{m.output.text}</b></div>}
    {m.duty.published && <div class="np-cell"><span>Duty</span><b>{m.duty.text}</b></div>}
    {m.input.published && <div class="np-cell"><span>Input</span><b>{m.input.text}</b></div>}
    {plug && <div class="np-cell"><span>Plug</span><b>{plug}</b></div>}
  </div>
  {m.voltages.includes(120) && d120 && <DutyBar mark={d120} outlet="120-15" label="10 min cycle, 120V" />}
  {m.voltages.includes(240) && d240 && <DutyBar mark={d240} outlet="240-50" label="10 min cycle, 240V class" />}
  {!fit.includes('120-15') && <p class="stamp" data-miss="120-15">Does not pass 120V/15A</p>}
  {!fit.includes('240-50') && <p class="stamp" data-miss="240-50">Does not pass 240V/50A</p>}
</section>

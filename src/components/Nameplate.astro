---
import type { Model } from '../data/models';
import { dutyMark, fitTokens, plugLine } from '../lib/plate';
import DutyBar from './DutyBar.astro';
interface Props { model: Model }
const { model: m } = Astro.props;
const fit = fitTokens(m);
const d120 = dutyMark(m.duty.text, 120, m.voltages);
const d240 = dutyMark(m.duty.text, 240, m.voltages);
const plug = plugLine(m.input.text);
---
<section class="nameplate" aria-label={`${m.name} rating plate`}>
  <div class="np-top">
    <p class="np-brand">{m.brand}</p>
    <p class="np-sku">{m.sku ? `SKU ${m.sku}` : 'No SKU on the sheet'}</p>
  </div>
  <p class="np-name">{m.name}</p>
  <div class="np-grid">
    <div class="np-cell"><span>Output</span><b>{m.output.published ? m.output.text : 'Not published'}</b></div>
    <div class="np-cell"><span>Duty</span><b>{m.duty.published ? m.duty.text : 'Not published'}</b></div>
    <div class="np-cell"><span>Input</span><b>{m.input.published ? m.input.text : 'Not published'}</b></div>
    <div class="np-cell"><span>Plug</span><b>{plug}</b></div>
  </div>
  {m.voltages.includes(120) && <DutyBar mark={d120} outlet="120-15" label="10-minute cycle at 120 V" />}
  {m.voltages.includes(240) && <DutyBar mark={d240} outlet="240-50" label="10-minute cycle at 240 V" />}
  {!fit.includes('120-15') && <p class="stamp" data-miss="120-15">Does not pass 120 V / 15 A</p>}
  {!fit.includes('240-50') && <p class="stamp" data-miss="240-50">Does not pass 240 V / 50 A</p>}
</section>

---
interface Props { active?: string }
const { active = '' } = Astro.props;
const links = [
  ['/', 'Home', 'home'],
  ['/models/', 'Models', 'models'],
  ['/compare/', 'Compare', 'compare'],
  ['/compare/best-multiprocess/', 'Multi', 'multi'],
  ['/which-welder/', 'Check', 'job'],
];
---
<header class="site">
  <div class="head-in wrap">
    <a class="brand" href="/">Weld<span>Facts</span><small>Welder specifications</small></a>
    <div class="chips" role="group" aria-label="Outlet filter">
      <button type="button" data-outlet-chip="120-15" aria-pressed="true">120 V / 15 A</button>
      <button type="button" data-outlet-chip="240-50" aria-pressed="false">240 V / 50 A</button>
    </div>
    <nav class="main" aria-label="Main">
      <ul>
        {links.map(([href, label, key]) => (
          <li><a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

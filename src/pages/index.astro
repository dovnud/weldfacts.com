---
import Base from '../layouts/Base.astro';
import Byline from '../components/Byline.astro';
import JobForm from '../components/JobForm.astro';
import MachineTable from '../components/MachineTable.astro';
import { models, brands } from '../data/models';
import { SITE } from '../lib/site';
import { crumbLd, webPageLd, websiteLd } from '../lib/ld';

const desc = '31 welders. Amp range, duty cycle, input, and thickness copied from the manufacturer sheet. Filter by 120V/15A or 240V/50A.';
const jsonld = [
  websiteLd(desc),
  webPageLd('Welder specs and which machine fits the outlet', '/', desc, SITE.checked),
  crumbLd([]),
  {
    '@type': 'ItemList',
    name: 'Welder spec pages',
    itemListElement: models.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.name, url: SITE.url + `/models/${m.slug}/` })),
  },
];
---
<Base title="Welder specs and which machine fits" description={desc} path="/" nav="home" og="/og/default.png" jsonld={jsonld}>
  <div class="wrap pagehead">
    <p class="kicker">Read 2 November 2026 · {models.length} models · {brands().length} brands</p>
    <h1>Sheet. Outlet. Job.</h1>
    <p class="lede">Numbers come from the maker. A blank stays blank. The chip is 120V/15A or 240V/50A. A machine that fails that outlet drops off the table.</p>
    <Byline />
    <JobForm />
    <h2>Spec index</h2>
    <MachineTable rows={models} />
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import Byline from '../components/Byline.astro';
import Crumbs from '../components/Crumbs.astro';
import { SITE } from '../lib/site';
import { crumbLd, webPageLd } from '../lib/ld';

const crumbs = [{ name: 'Terms', path: '/terms/' }];
const desc = 'Terms of use for WeldFacts.com. Specs are transcriptions of manufacturer pages. The manufacturer manual governs the machine.';
const jsonld = [webPageLd('Terms of use', '/terms/', desc, SITE.checked), crumbLd(crumbs)];
---
<Base title="Terms of use" description={desc} path="/terms/" og="/og/page-terms.png" jsonld={jsonld}>
  <div class="wrap prose">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Terms</h1>
      <Byline />
    </div>
    <p>The tables are transcriptions as of the checked date. Makers change products. Read the manual that comes with the machine.</p>
    <p>The job check compares your numbers with published numbers. It is not an electrical inspection. A pass does not prove the breaker in the wall is the size you typed.</p>
    <p>Product names identify machines. They belong to their owners. This site is not those companies and not Amazon.</p>
    <p>Amazon links use tag weldfacts-20. See the <a href="/affiliate-disclosure/">affiliate disclosure</a>.</p>
    <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </div>
</Base>

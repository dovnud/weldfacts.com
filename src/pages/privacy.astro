---
import Base from '../layouts/Base.astro';
import Byline from '../components/Byline.astro';
import Crumbs from '../components/Crumbs.astro';
import { SITE } from '../lib/site';
import { crumbLd, webPageLd } from '../lib/ld';

const crumbs = [{ name: 'Privacy', path: '/privacy/' }];
const desc = `Privacy policy for WeldFacts.com. No ads and no newsletter. Contact ${SITE.email}.`;
const jsonld = [webPageLd('Privacy policy', '/privacy/', desc, SITE.checked), crumbLd(crumbs)];
---
<Base title="Privacy policy" description={desc} path="/privacy/" og="/og/page-privacy.png" jsonld={jsonld}>
  <div class="wrap prose">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Privacy</h1>
      <Byline />
    </div>
    <p>Static site. No account. The job check runs in the browser. The numbers you type are not sent here. The outlet chip is stored in localStorage on your machine.</p>
    <h2>Mail</h2>
    <p>The contact page opens your mail app to {SITE.email}. This site does not receive the message.</p>
    <h2>Cookies</h2>
    <p>No analytics cookie. No ad script. Cloudflare may keep request logs. Amazon may set cookies if you follow a search link.</p>
    <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </div>
</Base>

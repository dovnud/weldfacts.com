---
import Base from '../layouts/Base.astro';
import Byline from '../components/Byline.astro';
import Crumbs from '../components/Crumbs.astro';
import { SITE } from '../lib/site';
import { crumbLd, orgLd, webPageLd } from '../lib/ld';

const crumbs = [{ name: 'About', path: '/about/' }];
const desc = 'WeldFacts.com is an independent reference for manufacturer welder specs and an outlet check. Pages are by the WeldFacts editorial team.';
const jsonld = [
  webPageLd('About WeldFacts.com', '/about/', desc, SITE.checked),
  crumbLd(crumbs),
  { '@type': 'AboutPage', name: 'About WeldFacts.com', url: SITE.url + '/about/' },
  orgLd(),
];
---
<Base title="About WeldFacts.com" description={desc} path="/about/" nav="about" og="/og/page-about.png" jsonld={jsonld}>
  <div class="wrap prose">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>About</h1>
      <Byline />
    </div>
    <p>WeldFacts prints welder specs from manufacturer pages and manuals. The outlet chip and the job check use those numbers.</p>
    <h2>Who</h2>
    <p>Published by WeldFacts. The byline is the WeldFacts editorial team. No personal name on a transcription. Judge the source link.</p>
    <h2>The date</h2>
    <p>Checked 2 November 2026 means that is when the cited pages were read. A layout change does not move the date.</p>
    <h2>Money</h2>
    <p>Free to read. Amazon tag weldfacts-20. The tag does not change a spec. See the <a href="/affiliate-disclosure/">affiliate disclosure</a>.</p>
    <h2>Not this</h2>
    <p>Not a dealer. Not a shop. Not an electrical inspection. The manual that ships with the machine still governs setup.</p>
    <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import SpecTable from '../../components/SpecTable.astro';
import BuyBlock from '../../components/BuyBlock.astro';
import Blocks from '../../components/Blocks.astro';
import Nameplate from '../../components/Nameplate.astro';
import { modelPath, pairs } from '../../data/models';
import { models } from '../../data/models';
import { modelBlocks } from '../../lib/guide';
import { modelPageLd, specRows } from '../../lib/modelView';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return models.map((m) => ({ params: { slug: m.slug }, props: { model: m } }));
}
const { model: m } = Astro.props;
const path = modelPath(m);
const crumbs = [{ name: 'Models', path: '/models/' }, { name: m.name, path }];
const desc = m.summary;
const blocks = modelBlocks(m);
const related = pairs().filter((p) => p.a.slug === m.slug || p.b.slug === m.slug);
const jsonld = modelPageLd(m, SITE.checked);
const rows = specRows(m);
---
<Base title={`${m.name} specs`} description={desc} path={path} nav="models" og={`/og/model-${m.slug}.png`} ogAlt={`${m.name} specs`} jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>{m.name}</h1>
      <p class="lede">{m.summary}</p>
      <p class="small muted">{m.brand}{m.sku ? `, SKU ${m.sku}` : ''}. <a href={`/brands/${m.brandSlug}/`}>{m.brand} lineup</a></p>
    </div>
    <Nameplate model={m} />
    <BuyBlock slug={m.slug} query={m.searchQuery} name={m.name} />
    <Blocks blocks={blocks} />
    <h2>Specifications</h2>
    <p class="small">Each cell is the wording from the cited page.</p>
    <SpecTable rows={rows} />
    <p>
      <a href={m.productUrl} rel="noopener">Manufacturer page</a>
      · <a href={`/which-welder/?model=${m.slug}`}>Job check</a>
      · <a href={`/brands/${m.brandSlug}/`}>{m.brand}</a>
    </p>
    {related.length > 0 && (
      <>
        <h2>Comparisons</h2>
        <ul>
          {related.map((p) => {
            const other = p.a.slug === m.slug ? p.b : p.a;
            return <li><a href={`/compare/${p.slug}/`}>{m.name} vs {other.name}</a></li>;
          })}
        </ul>
      </>
    )}
  </div>
</Base>

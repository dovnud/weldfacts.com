---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Guide from '../../components/Guide.astro';
import { pairs, modelPath } from '../../data/models';
import { pairIsUseful, pairSections } from '../../lib/guide';
import { specRows } from '../../lib/modelView';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

export function getStaticPaths() {
  return pairs().map((p) => ({ params: { pair: p.slug }, props: { pair: p } }));
}
const { pair } = Astro.props;
const path = `/compare/${pair.slug}/`;
const crumbs = [{ name: 'Compare', path: '/compare/' }, { name: `${pair.a.name} vs ${pair.b.name}`, path }];
const useful = pairIsUseful(pair.a, pair.b);
const sections = useful ? pairSections(pair.a, pair.b) : [];
const desc = useful
  ? `${pair.a.name} vs ${pair.b.name}: jobs, power, duty cycle, included items, and a verdict from the manufacturer fields.`
  : `${pair.a.name} and ${pair.b.name} do not share a published process. This pair is not an indexed comparison.`;
const rowsA = specRows(pair.a);
const rowsB = specRows(pair.b);
const jsonld = [
  webPageLd(`${pair.a.name} vs ${pair.b.name}`, path, desc, SITE.checked),
  crumbLd(crumbs),
  {
    '@type': 'ItemList',
    itemListElement: [pair.a, pair.b].map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.name, url: SITE.url + modelPath(m) })),
  },
  ...(useful
    ? [{
        '@type': 'FAQPage',
        mainEntity: sections.map((section) => ({
          '@type': 'Question',
          name: section.heading,
          acceptedAnswer: { '@type': 'Answer', text: section.paragraphs.join(' ') },
        })),
      }]
    : []),
];
---
<Base title={`${pair.a.name} vs ${pair.b.name}`} description={desc} path={path} nav="compare" og="/og/page-compare.png" jsonld={jsonld} noindex={!useful}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>{pair.a.name} vs {pair.b.name}</h1>
      {useful ? (
        <p class="lede">Same fields from each manufacturer page. A blank stays "Not published by manufacturer." The outlet chip does not hide either column.</p>
      ) : (
        <p class="lede">{pair.a.name} and {pair.b.name} are different brands, and the cited pages do not name a shared process. This URL is not a buying guide. It is noindex and is left out of the sitemap. Read each model page for jobs, power, duty cycle, and a verdict.</p>
      )}
    </div>
    {useful && <Guide sections={sections} />}
    {!useful && (
      <p>
        <a href={modelPath(pair.a)}>{pair.a.name}</a>
        {' · '}
        <a href={modelPath(pair.b)}>{pair.b.name}</a>
        {' · '}
        <a href="/compare/">All comparisons</a>
      </p>
    )}
    <h2>Specifications side by side</h2>
    <div class="tblwrap">
      <table>
        <thead>
          <tr>
            <th>Spec</th>
            <th><a href={modelPath(pair.a)}>{pair.a.name}</a></th>
            <th><a href={modelPath(pair.b)}>{pair.b.name}</a></th>
          </tr>
        </thead>
        <tbody>
          {rowsA.map((row, i) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td class={row.field.published ? undefined : 'unpub'}>
                {row.field.text}
                <div class="small"><a href={row.field.cite.url} rel="noopener">Source</a></div>
              </td>
              <td class={rowsB[i].field.published ? undefined : 'unpub'}>
                {rowsB[i].field.text}
                <div class="small"><a href={rowsB[i].field.cite.url} rel="noopener">Source</a></div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p><a href={`/which-welder/?model=${pair.a.slug}`}>Outlet check, {pair.a.name}</a> · <a href={`/which-welder/?model=${pair.b.slug}`}>Outlet check, {pair.b.name}</a></p>
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { models, modelPath, steelMax } from '../../data/models';
import { dutyMark, fitTokens } from '../../lib/plate';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

const ranked = models
  .filter((m) => m.voltages.includes(120))
  .map((m) => ({ m, thick: steelMax(m, 120) }))
  .sort((a, b) => {
    if (a.thick == null && b.thick == null) return a.m.name.localeCompare(b.m.name);
    if (a.thick == null) return 1;
    if (b.thick == null) return -1;
    return b.thick - a.thick || a.m.name.localeCompare(b.m.name);
  });
const path = '/compare/best-for-120v/';
const crumbs = [{ name: 'Compare', path: '/compare/' }, { name: '120 V', path }];
const desc = 'Welders with a published 120 V input, ranked by the mild-steel thickness the manufacturer printed for that voltage.';
const jsonld = [
  webPageLd('Welders for a 120 V outlet', path, desc, SITE.checked),
  crumbLd(crumbs),
  { '@type': 'ItemList', itemListElement: ranked.map((row, i) => ({ '@type': 'ListItem', position: i + 1, name: row.m.name, url: SITE.url + modelPath(row.m) })) },
];
---
<Base title="Welders for a 120 V outlet" description={desc} path={path} nav="v120" og="/og/page-120v.png" jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Welders for a 120 V outlet</h1>
      <p class="lede">Machines whose published input includes 120 V. The order is the mild-steel thickness stored for that voltage.</p>
    </div>
    <div class="prose">
      <p>110 V and 115 V count as this list. 240 V-only machines stay on the <a href="/compare/best-for-240v/">240 V list</a>. A blank thickness sorts after every machine that has one, in name order. The thickness column is the inch figure the job check stores for mild steel at 120 V. Where the sheet calls that figure a single pass and does not print a second maximum, a thicker job warns. Gauge ranges are not converted into inches, so a machine that prints aluminum only as a gauge does not get an aluminum inch in this column.</p>
      <p>Duty text in the table is the manufacturer's sentence, not a rank. A 60% point and a 20% point are both copied. The minute reading of each percent is on the model page. Input current is not in this table. A machine can lead on thickness and still fail a 15 A breaker. The outlet button hides that failure. Use the <a href="/which-welder/">job check</a> when you know the breaker size.</p>
      {ranked[0]?.thick != null && (
        <p>The first row with a stored thickness is {ranked[0].m.name} at {ranked[0].thick} in. {ranked.filter((row) => row.thick == null).length} machines on this list have no mild-steel inch figure, so they sort last{ranked.filter((row) => row.thick == null).length ? `: ${ranked.filter((row) => row.thick == null).map((row) => row.m.name).join(', ')}` : ''}.</p>
      )}
    </div>
    <div class="tblwrap">
      <table>
        <thead><tr><th>#</th><th>Model</th><th>120 V mild steel, published</th><th>Duty cycle</th></tr></thead>
        <tbody>
          {ranked.map((row, i) => (
            <tr data-fit={fitTokens(row.m) || 'none'}>
              <td>{i + 1}</td>
              <td><a href={modelPath(row.m)}>{row.m.name}</a></td>
              <td>{row.thick == null ? 'Not published' : `${row.thick} in max`}</td>
              <td>{dutyMark(row.m.duty.text, 120, row.m.voltages)?.clause ?? (row.m.duty.published ? row.m.duty.text : 'Not published')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted">Use the <a href="/which-welder/">outlet check</a> when you know the breaker size. Input current at rated output is not the same thing as a recommended breaker.</p>
  </div>
</Base>

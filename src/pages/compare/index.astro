---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { models, pairs } from '../../data/models';
import { SITE } from '../../lib/site';
import { crumbLd, webPageLd } from '../../lib/ld';

const crumbs = [{ name: 'Compare', path: '/compare/' }];
const desc = 'Side-by-side welder specs. Each pair quotes both manufacturer sheets and does not add a score.';
const list = pairs();
const same = list.filter((p) => p.a.brandSlug === p.b.brandSlug);
const cross = list.filter((p) => p.a.brandSlug !== p.b.brandSlug);
const jsonld = [webPageLd('Compare welder specs', '/compare/', desc, SITE.checked), crumbLd(crumbs)];
---
<Base title="Compare welder specs" description={desc} path="/compare/" nav="compare" og="/og/page-compare.png" jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Compare welder specs</h1>
      <p class="lede">A pair page quotes both sheets. It does not add a score. Same-brand pairs are the left list. Cross-brand pairs are the right list. Ranked lists: <a href="/compare/best-for-120v/">120 V</a>, <a href="/compare/best-for-240v/">240 V</a>, <a href="/compare/best-multiprocess/">multi-process</a>.</p>
    </div>
    <form class="finder" id="pair-form">
      <div class="finder-head">Choose two models <span>{same.length} same brand, {cross.length} cross brand</span></div>
      <div class="finder-body">
        <div class="f-grid">
          <div>
            <label for="a">First</label>
            <select id="a" name="a">{models.map((m) => <option value={m.slug}>{m.name}</option>)}</select>
          </div>
          <div>
            <label for="b">Second</label>
            <select id="b" name="b">{models.map((m, i) => <option value={m.slug} selected={i === 1}>{m.name}</option>)}</select>
          </div>
        </div>
        <button class="f-btn" type="submit">Open comparison</button>
        <p id="pair-note" class="note" hidden></p>
      </div>
    </form>
    <div class="pair-groups">
      <div>
        <h2>Same brand</h2>
        <ul>
          {same.map((p) => <li><a href={`/compare/${p.slug}/`}>{p.a.name} vs {p.b.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Cross brand</h2>
        <ul>
          {cross.map((p) => <li><a href={`/compare/${p.slug}/`}>{p.a.name} vs {p.b.name}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</Base>
<script>
  import { models, pairs, modelPath } from '../../data/models';
  const form = document.getElementById('pair-form') as HTMLFormElement;
  const note = document.getElementById('pair-note') as HTMLElement;
  const allowed = new Set(pairs().map((p) => p.slug));
  form.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const data = new FormData(form);
    const a = String(data.get('a'));
    const b = String(data.get('b'));
    note.hidden = true;
    note.textContent = '';
    if (a === b) {
      note.hidden = false;
      note.textContent = 'Pick two different models.';
      return;
    }
    const ia = models.findIndex((m) => m.slug === a);
    const ib = models.findIndex((m) => m.slug === b);
    const slug = ia < ib ? `${a}-vs-${b}` : `${b}-vs-${a}`;
    if (!allowed.has(slug)) {
      const left = models[ia];
      const right = models[ib];
      note.hidden = false;
      note.innerHTML = `<a href="${modelPath(left)}">${left.name}</a> · <a href="${modelPath(right)}">${right.name}</a>`;
      return;
    }
    location.href = `/compare/${slug}/`;
  });
</script>

---
import Base from '../layouts/Base.astro';
import Byline from '../components/Byline.astro';
import Crumbs from '../components/Crumbs.astro';
import JobForm from '../components/JobForm.astro';
import FaqList from '../components/FaqList.astro';
import { SITE } from '../lib/site';
import { crumbLd, webPageLd } from '../lib/ld';

const crumbs = [{ name: 'Check', path: '/which-welder/' }];
const desc = 'Match a 120 V or 240 V outlet, breaker size, metal, thickness, and process to published welder ratings. Missing figures are not filled in.';
const faqs = [
  {
    q: 'Does a 230 V rating count as a 240 V outlet?',
    a: 'Yes. 208-240 V, 230 V, and 240 V match the 240 V chip. 460 V and 575 V match neither chip. 110 V, 115 V, and 120 V match the 120 V chip.',
  },
  {
    q: 'Is input current the breaker size?',
    a: 'No. Input current at rated output is a draw. A draw above the breaker fails. A draw that fits, with no breaker size on the sheet, is a warning. A pass needs a breaker size the maker printed, such as the Handler 210i 15 A and 20 A rows.',
  },
  {
    q: 'What if thickness is a single-pass figure?',
    a: 'If the page says single pass and does not print a multi-pass maximum, a thicker job is a warning. If the page prints a maximum and does not call it single pass, a thicker job fails.',
  },
  {
    q: 'Why can aluminum fail on a TIG welder?',
    a: 'Aluminum passes only when the cited page names aluminum. DC TIG that does not name aluminum fails that metal.',
  },
];
const jsonld = [
  webPageLd('Which welder for this outlet and job', '/which-welder/', desc, SITE.checked),
  crumbLd(crumbs),
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title="Which welder for this outlet" description={desc} path="/which-welder/" nav="job" og="/og/page-which-welder.png" jsonld={jsonld}>
  <div class="wrap">
    <div class="pagehead">
      <Crumbs crumbs={crumbs} />
      <h1>Job check</h1>
      <p class="lede">Outlet, breaker, metal, thickness, process. Pass means the sheet printed the number. Partial means a figure is missing or only partly covers the outlet.</p>
      <Byline />
    </div>
    <JobForm />
    <h2>Rules</h2>
    <ul class="rule-list">
      <li>230 V and 208-240 V count as the 240 V outlet. The result says when that mapping is used.</li>
      <li>A named breaker row is a pass only when the input current on that row also fits.</li>
      <li>Input amps with no breaker size: under the breaker is a warning, over it is a fail.</li>
      <li>Process has to be named. Aluminum on TIG needs the word aluminum on the page.</li>
      <li>Thickness uses a printed inch maximum. Gauge is not converted.</li>
    </ul>
    <FaqList items={faqs} />
  </div>
</Base>

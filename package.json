{
  "name": "weldfacts-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node --experimental-strip-types scripts/check-specs.mjs && node --experimental-strip-types scripts/schema.test.mjs && node --experimental-strip-types scripts/gen-og.mjs",
    "build": "astro build && node scripts/check-words.mjs",
    "postbuild": "node --experimental-strip-types scripts/schema.test.mjs --dist",
    "preview": "astro preview",
    "og": "node --experimental-strip-types scripts/gen-og.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test": "node --experimental-strip-types scripts/job.test.mjs && node --experimental-strip-types scripts/schema.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
